# PIB Daily Tracker Configuration

# Digest generation time (24-hour format)
PIB_DIGEST_TIME=20:00

# PIB Website URL
PIB_BASE_URL=https://pib.gov.in

# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=logs/pib_tracker.log

# Request configuration
MAX_RETRIES=3
REQUEST_TIMEOUT=30
CONNECTION_POOL_SIZE=10

# Browser configuration for Selenium
HEADLESS_BROWSER=true
BROWSER_TIMEOUT=60

# Proxy (optional)
# HTTP_PROXY=
# HTTPS_PROXY=

# OpenAI API key (for AI summarization, optional)
# OPENAI_API_KEY=

# Cache configuration
USE_CACHE=true
CACHE_EXPIRY_HOURS=24

# Database (optional for historical storage)
# DATABASE_URL=sqlite:///pib_tracker.db

# Timezone
TIMEZONE=Asia/Kolkata
